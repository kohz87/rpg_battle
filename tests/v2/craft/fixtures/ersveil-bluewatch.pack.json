    "events": [
      {"id": "guild-board", "when": "query('scene.place').name == 'Bluewatch Village' && time() != null && time() >= 316931520", "cue": "The Guild office beside the Watchhouse opens its shutters. Fenna, the branch clerk, pins three F-letter notices to the board: Granary Rats (6 cellar rats, 50 marks), East Bluff Wolves (4 starved crag wolves, 200 marks) and Culvert Leeches (8 sluice leeches off the north culvert grate by Goldwane 14 dusk, 120 marks)."},
      {"id": "wolves-at-dusk", "after": "guild-board", "when": "time() != null && time() >= 316932180 && !(quest('East Bluff Wolves') != null && quest('East Bluff Wolves').ended != null && quest('East Bluff Wolves').ended.outcome == 'done')", "cue": "At dusk the crag wolves howl from the east bluff, close enough that the tower watch counts them aloud: four, maybe five, and one deeper voice."},
      {"id": "culvert-rising", "after": "guild-board", "when": "time() != null && time() >= 316933560 && !(quest('Culvert Leeches') != null && quest('Culvert Leeches').ended != null && quest('Culvert Leeches').ended.outcome == 'done')", "cue": "Rain in the northern hills: the north culvert runs brown and high, its grate thick with leeches. The sluice keeper says it will back up by tomorrow dusk."},
      {"id": "culvert-floods", "after": "culvert-rising", "when": "time() != null && time() >= 316935060 && !(quest('Culvert Leeches') != null && quest('Culvert Leeches').ended != null && quest('Culvert Leeches').ended.outcome == 'done')", "cue": "The clogged north culvert backs up. Muddy water floods the storehouse lane and the lowest granary cellar; the Watch blames the Guild office for a job left on the board."},
      {"id": "culvert-cleared", "after": "guild-board", "when": "(quest('Culvert Leeches') != null && quest('Culvert Leeches').ended != null && quest('Culvert Leeches').ended.outcome == 'done') && time() != null && time() < 316935060", "cue": "A runner from the Watchhouse: the north culvert ran clear through the hill rain. Watch-Captain Rorke sends 20 marks on top of the Guild's fee.", "then": [{"command": "wallet.receive", "payload": {"owner": "party", "amount": 20, "note": "Watch-Captain Rorke's thanks for the culvert"}}]},
      {"id": "granary-cleared", "after": "guild-board", "when": "(quest('Granary Rats') != null && quest('Granary Rats').ended != null && quest('Granary Rats').ended.outcome == 'done')", "cue": "Word goes round the storehouses that the granary cellars are quiet; the quartermaster nods at the newcomer for the first time."}
    ],
    "quests": [
      {"name": "Granary Rats", "type": "side", "giver": "Fenna", "place": "Bluewatch Village", "spot": "Watch Granary", "letter": "F", "goal": "Clear the cellar rats out of the Watch granary under the storehouses", "target": "6 cellar rats", "reward": "50 marks", "step": "Posted on the Guild office board", "note": "A poor client: the Watch pays below Guild rates."},
      {"name": "East Bluff Wolves", "aliases": ["EastBluffWolves"], "type": "side", "giver": "Fenna", "place": "Bluewatch Village", "spot": "East Bluff", "letter": "F", "goal": "Hunt the starved crag wolf pack off the east bluff", "target": "4 crag wolves", "reward": "200 marks", "step": "Posted on the Guild office board", "note": "Dangerous F work. Pelts belong to whoever butchers them; the Watch-Captain claims a tenth."},
      {"name": "Culvert Leeches", "type": "side", "giver": "Fenna", "place": "Bluewatch Village", "spot": "North Culvert", "letter": "F", "goal": "Scrape the sluice leeches off the north culvert grate before the hill rain comes down", "target": "8 sluice leeches", "reward": "120 marks", "due": "Goldwane 14, 07:00 pm", "step": "Posted on the Guild office board", "note": "If the grate stays clogged when the rain comes, the culvert backs up into the storehouse lane."}
    ],
    "races": [
      {"id": "human", "name": "Human", "note": "The most numerous people, masters of the Northern Belt and the rivers. Short, hard lives. No stat change, so a kit's stats come out as written.", "stats": {}, "tags": ["human"]},
      {"id": "elf", "name": "Elf", "note": "Three to five centuries of life and a long memory for what humans did. Tolerated, resented, still sold in slave markets.", "stats": {"DEX": 1, "VIT": -1}, "tags": ["elf"]},
      {"id": "dwarf", "name": "Dwarf", "note": "Hold-born, oath-bound, about two centuries of life. \"Stone remembers.\"", "stats": {"VIT": 1, "AGI": -1}, "tags": ["dwarf"]},
      {"id": "halfling", "name": "Halfling", "note": "River-town folk of barges, kitchens and ledgers; quietly indispensable to Confederacy trade.", "stats": {"LUK": 1, "STR": -1}, "tags": ["halfling", "small"]},
      {"id": "beastfolk", "name": "Beastfolk", "note": "Animal ears, tails or horns and keen senses; refused rooms and suspected first, valued as scouts.", "stats": {"AGI": 1, "CHA": -1}, "tags": ["beastfolk"]},
      {"id": "orc", "name": "Orc", "note": "Large, strong, short-lived; vilified as half-monsters, with bounties in some Highmark provinces.", "stats": {"STR": 1, "CHA": -1}, "tags": ["orc"]},
      {"id": "goblin", "name": "Goblin", "note": "Small, quick, short-lived fixers and couriers nobody notices until too late; most realms treat them as vermin.", "stats": {"DEX": 1, "STR": -1}, "tags": ["goblin", "small"]}
    ],
    "talents": [
      {"id": "shadow-bent", "name": "Shadow-bent", "note": "An outward bent toward shadow, woken late and self-taught, with no spell grammar.", "stats": {"INT": 1}, "tags": ["shadow", "outward-bent"]},
      {"id": "river-born", "name": "River-born", "note": "Born on the Confederacy waterways: Riverspeech first, at home on a barge deck and in cold water.", "stats": {"AGI": 1}, "tags": ["river", "swimmer", "riverspeech"]},
      {"id": "hulkrow-raised", "name": "Hulkrow-raised", "note": "Grew up in the floating slum of Thousand Sails: reads a crowd, finds the back way out.", "stats": {"LUK": 1}, "tags": ["streetwise"]},
      {"id": "hidden-draw", "name": "Hidden Draw", "note": "A self-taught draw-cut from a hidden sheath: the first blow lands before the fight starts.", "stats": {"DEX": 1}, "tags": ["blade", "draw-cut"]},
      {"id": "inward-bent", "name": "Inward Bent", "note": "The common bent: mana pushed into the body for strength and toughness.", "stats": {"STR": 1, "VIT": 1}, "tags": ["inward-bent"]},
      {"id": "frontier-tracker", "name": "Frontier Tracker", "note": "Knows wolf sign, wet ground and which way the herds will run.", "stats": {"DEX": 1}, "tags": ["tracking", "frontier"]}
    ],
